# ============================================================
#  SG Ride-Sharing — Full API Test Suite
#  Base URL: http://localhost:5000
#
#  HOW TO USE (VS Code REST Client):
#  1. Install "REST Client" extension
#  2. Set variables below for your tokens
#  3. Send each request with "Send Request"
#
#  ⚠️  = known broken at runtime (see audit report)
#  ✅  = working
#  🔒  = requires auth token
#  🔑  = requires admin token
# ============================================================

@baseUrl = http://localhost:5000
@contentType = application/json

# ─── PASTE YOUR TOKENS HERE AFTER LOGIN ───────────────────
@riderToken = Bearer PASTE_RIDER_TOKEN_HERE
@driverToken = Bearer PASTE_DRIVER_TOKEN_HERE
@adminToken = Bearer PASTE_ADMIN_TOKEN_HERE

# ─── COMMON IDs (fill in after creating records) ──────────
@rideRequestId = 1
@rideId = 1
@bidId = 1
@userId = 1
@driverId = 1
@paymentMethodId = 1
@payoutRequestId = 1
@promoCode = WELCOME10
@giftCardCode = GC-XXXX-XXXX
@reviewId = 1
@paymentId = 1
@providerId = 1
@applicationId = 1
@stopId = 1
@driverDbId = 1
@activeRequestId = 1

# ─── SPRINT 8 MOBILE VARS (fill after mobile OTP flow) ───────
@mobileToken = PASTE_MOBILE_TOKEN_HERE
@mobileRefresh = PASTE_MOBILE_REFRESH_HERE
@mobileOtp = 123456

