POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "first_name": "{{driverFirstName}}",
  "last_name": "{{driverLastName}}",
  "email": "{{driverEmail}}",
  "password": "{{driverPassword}}",
  "phone_number": "{{driverPhone}}",
  "role": "driver"
}

