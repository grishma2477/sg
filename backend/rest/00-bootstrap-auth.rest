@baseUrl = {{baseUrl}}

### Health Check
GET {{baseUrl}}/

###

# Run once. If the email already exists, skip this block.
# @name registerRider
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "first_name": "{{riderFirstName}}",
  "last_name": "{{riderLastName}}",
  "email": "{{riderEmail}}",
  "password": "{{riderPassword}}",
  "phone_number": "{{riderPhone}}",
  "role": "rider"
}

###

# Run once. If the email already exists, skip this block.
