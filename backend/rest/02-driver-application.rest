@baseUrl = {{baseUrl}}
@kycBoundary = DriverKycBoundary
@appBoundary = DriverApplicationBoundary

### Login Admin
# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###

### Login Driver
# @name loginDriver
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{driverEmail}}",
  "password": "{{driverPassword}}"
}

###

### Driver KYC Status Before Submit
GET {{baseUrl}}/api/kyc/status
Authorization: Bearer {{loginDriver.response.body.$.token}}

###

### Submit Driver KYC
POST {{baseUrl}}/api/kyc/complete
Authorization: Bearer {{loginDriver.response.body.$.token}}
Content-Type: multipart/form-data; boundary={{kycBoundary}}

--{{kycBoundary}}
Content-Disposition: form-data; name="firstName"

{{driverFirstName}}
--{{kycBoundary}}
Content-Disposition: form-data; name="lastName"

{{driverLastName}}
--{{kycBoundary}}
Content-Disposition: form-data; name="dateOfBirth"

1994-02-21
--{{kycBoundary}}
Content-Disposition: form-data; name="address"

Lalitpur Metropolitan City, Nepal
--{{kycBoundary}}
Content-Disposition: form-data; name="phoneNumber"

{{driverPhone}}
--{{kycBoundary}}
Content-Disposition: form-data; name="email"

{{driverEmail}}
--{{kycBoundary}}
Content-Disposition: form-data; name="gender"

male
--{{kycBoundary}}
Content-Disposition: form-data; name="nationalIdentityNumber"

DRIVER-REST-0001
--{{kycBoundary}}
Content-Disposition: form-data; name="bloodGroup"

A+
--{{kycBoundary}}
Content-Disposition: form-data; name="documentType"

license
--{{kycBoundary}}
Content-Disposition: form-data; name="documentNumber"

DRV-DOC-0001
--{{kycBoundary}}
Content-Disposition: form-data; name="issuedDate"

2016-01-10
--{{kycBoundary}}
Content-Disposition: form-data; name="expiryDate"

2032-01-10
--{{kycBoundary}}
Content-Disposition: form-data; name="profilePhoto"; filename="person.svg"
Content-Type: image/svg+xml

< ./_fixtures/person.svg
--{{kycBoundary}}
Content-Disposition: form-data; name="documentFront"; filename="document-front.svg"
Content-Type: image/svg+xml

< ./_fixtures/document.svg
--{{kycBoundary}}
Content-Disposition: form-data; name="documentBack"; filename="document-back.svg"
Content-Type: image/svg+xml

< ./_fixtures/document.svg
--{{kycBoundary}}--

