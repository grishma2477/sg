          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh"] }
          }
        },
        {
          "name": "Refresh — invalid token (expect 401 NOT_FOUND)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));"],
