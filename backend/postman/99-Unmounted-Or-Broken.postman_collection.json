{
  "info": {
    "_postman_id": "0efcdd8e-6ea7-4c8a-9031-6626cae0a0e8",
    "name": "SG Backend 99 - Unmounted Or Broken",
    "description": "Routes that exist in code but are not mounted in src/app.js, plus mounted routes that are currently broken because of backend code issues. Safety comment URLs assume a base mount of /api/safety-comments if you wire that router later.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) pm.environment.set('adminToken', json.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Login Rider",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) pm.environment.set('riderToken', json.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{riderEmail}}\",\n  \"password\": \"{{riderPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Login Driver",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) pm.environment.set('driverToken', json.token);",
              "if (json.driverId) pm.environment.set('driverDriverId', json.driverId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{driverEmail}}\",\n  \"password\": \"{{driverPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Broken Mounted - Get Payment Methods",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{riderToken}}" }
        ],
        "url": "{{baseUrl}}/api/payments/methods"
      }
    },
    {
      "name": "Broken Mounted - Get Nearby Drivers",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{riderToken}}" }
        ],
        "url": "{{baseUrl}}/api/ride-requests/drivers/nearby?lat=27.7172&lng=85.324&radius=5"
      }
    },
    {
      "name": "Broken Mounted - Admin Payment Providers List",
      "request": {
