    {
      "name": "Unmounted - Add Safety Comment",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.data && json.data.id) pm.environment.set('commentId', json.data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{riderToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"commentText\": \"Unsafe braking and sudden turns.\",\n  \"safetyCategory\": \"driving_behavior\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/safety-comments/reviews/{{reviewId}}/comments"
      }
    },
    {
      "name": "Unmounted - Get Review Comments",
      "request": {
        "method": "GET",
