          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Broken Admin Provider\",\n  \"type\": \"wallet\",\n  \"config\": {\n    \"mode\": \"sandbox\"\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/admin/payment-providers"
      }
    },
    {
