# ════════════════════════════════════════════════════════════
#  SG — Environment Variables Reference
#  Copy to .env and fill in real values.
#  NEVER commit .env to git.
# ════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=sg_db
POSTGRES_USER=sg_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sg_db
DB_USER=sg_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgres://sg_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/sg_db

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── JWT ──────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET_KEY=GENERATE_64_BYTE_HEX
REFRESH_TOKEN_SECRET_KEY=GENERATE_64_BYTE_HEX_DIFFERENT
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Cloudinary (KYC document uploads) ────────────────────────
# TODO: Get from cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── SMS / OTP ────────────────────────────────────────────────
# Option A: Sparrow SMS (Nepal)
# TODO: Get from sparrowsms.com
SPARROW_SMS_TOKEN=your_sparrow_token
SPARROW_SMS_FROM=SG

# Option B: Twilio (international)
# TODO: Get from twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── Firebase (FCM push notifications) ────────────────────────
# TODO: Get from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ── Google Maps ───────────────────────────────────────────────
# TODO: Get from console.cloud.google.com → Credentials
# Enable: Maps JavaScript API, Directions API, Geocoding API, Places API
GOOGLE_MAPS_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Payment Gateways ─────────────────────────────────────────
# eSewa
# TODO: Get from esewa.com.np → Merchant Dashboard
ESEWA_MERCHANT_ID=your_esewa_merchant_id
ESEWA_SECRET_KEY=your_esewa_secret

# Khalti
# TODO: Get from khalti.com → Merchant Dashboard
KHALTI_SECRET_KEY=your_khalti_secret_key

# ── Error Tracking (Sentry) ───────────────────────────────────
# TODO: Get from sentry.io → New Project → Node.js
SENTRY_DSN=https://xxxx@oXXXXX.ingest.sentry.io/XXXXXX

# ── Backups ───────────────────────────────────────────────────
BACKUP_DIR=/backups
# TODO: Fill in if uploading backups to S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-1
# S3_BACKUP_BUCKET=sg-backups

# ── Frontend (Vite) ───────────────────────────────────────────
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
VITE_GOOGLE_MAPS_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TODO: Get from sentry.io → New Project → React
VITE_SENTRY_DSN=https://xxxx@oXXXXX.ingest.sentry.io/XXXXXX

# ── Mobile (Expo) ─────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TODO: Get from sentry.io → New Project → React Native
EXPO_PUBLIC_SENTRY_DSN=https://xxxx@oXXXXX.ingest.sentry.io/XXXXXX
